# Bill of Materials — May 2026 stable pins.
# Single source of truth for runtime versions across every host.
# Proto resolves these on `proto use` (run automatically by devenv's
# enterShell). To verify drift: `moon run dotfiles:check-toolchain`.

node = "24"     # Active LTS as of Oct 2025; current LTS in May 2026
npm  = "11"     # Current major; proto manages it independently of Node's bundled npm
pnpm = "11"     # Built-in proto plugin; runtime shim replaces the standalone installer
bun  = "1"      # Latest 1.x stable
go   = "1.26"   # 2026.02 release line
rust = "stable" # rustup channel — proto's rust plugin shells through
python = "3.14" # Latest stable minor (3.14.x, Oct 2025 line). Python has no LTS —
                # each minor gets ~5yr of security fixes; "latest" is the pin.
                # proto's built-in plugin pulls python-build-standalone.

# Tooling that participates in the same hermetic boundary as runtimes.
moon = "2.3.2" # v2 "Phobos" — config schema migrated (toolchains.yml, layer:, pipeline:)

[plugins]
# Built-in proto plugins (node, bun, deno, go, rust, python) load
# automatically — no entry needed. Declare community Wasm plugins here.
# Examples (commented; uncomment to activate):
# zig = "https://github.com/konomae/zigup-plugin/releases/download/v0.1.0/zigup_plugin.wasm"
# biome = "https://github.com/moonrepo/plugins/releases/download/biome_tool-v0.4.0/biome_tool.wasm"

[settings]
# Pinned versions are authoritative; never auto-bump on shell entry.
auto-install = true
detect-strategy = "prefer-prototools"
