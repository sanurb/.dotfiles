# ╔═════════════════════════════════════════════════════════════════════╗
# ║  Ghostty — tuned for low cognitive friction                         ║
# ║                                                                     ║
# ║  Principles applied:                                                ║
# ║   1. Suppress involuntary attention capture (no blink, hide mouse). ║
# ║   2. Aid saccadic reacquisition (cursor-smear shader).              ║
# ║   3. Reduce edge competition (blur + slight opacity).               ║
# ║   4. Visual focus hierarchy (dim unfocused splits).                 ║
# ║   5. Eliminate friction actions (copy-on-select).                   ║
# ║   6. Breathing room (padding).                                      ║
# ║                                                                     ║
# ║  Vendored from Gentleman.Dots/GentlemanGhostty: shaders/, themes/.  ║
# ╚═════════════════════════════════════════════════════════════════════╝

# ─── Theme ────────────────────────────────────────────────────────────
# Custom palette in themes/gentleman.conf — deep navy bg, warm-yellow
# cursor, balanced palette tuned for dark-mode legibility.
theme = gentleman

# ─── Typography ───────────────────────────────────────────────────────
# Iosevka Nerd Font Mono — declared in modules/home/font.nix.
font-family = Iosevka Nerd Font Mono
font-size = 14
font-thicken = true

# ─── Window ───────────────────────────────────────────────────────────
window-decoration = true
window-padding-x = 10
window-padding-y = 8
window-padding-color = extend
window-padding-balance = true
window-colorspace = display-p3
window-save-state = always

# Translucent + blurred backdrop creates a depth-of-field cue that
# reduces edge competition with foreground content.
background-opacity = 0.95
background-blur-radius = 20

# ─── macOS flair ──────────────────────────────────────────────────────
macos-icon = holographic
macos-titlebar-style = transparent
macos-option-as-alt = left

# ─── Cursor ───────────────────────────────────────────────────────────
# Blinking cursors trigger motion-onset detection (V1/MT) that pulls
# peripheral attention away from reading. Static block + invert.
cursor-style = block
cursor-style-blink = false
cursor-invert-fg-bg = true

# Cursor smear: a brief motion trail acts as a saccadic landing cue
# after window/split switches — easier to reacquire cursor position.
custom-shader = shaders/cursor_smear_gentleman.glsl

# ─── Mouse ────────────────────────────────────────────────────────────
mouse-hide-while-typing = true
copy-on-select = clipboard
link-url = true

# ─── Splits ───────────────────────────────────────────────────────────
# Dimming unfocused panes routes attention without forcing the user to
# check which split owns the keyboard.
unfocused-split-opacity = 0.85
unfocused-split-fill = 06080f

# ─── Shell ────────────────────────────────────────────────────────────
shell-integration = detect
shell-integration-features = ssh-env,ssh-terminfo,title,cursor,sudo

# ─── Misc ─────────────────────────────────────────────────────────────
confirm-close-surface = false
clipboard-trim-trailing-spaces = true
quit-after-last-window-closed = true

# ─── Quick terminal (drop-down overlay) ───────────────────────────────
quick-terminal-autohide = false
quick-terminal-size = 100%,100%
quick-terminal-keyboard-interactivity = exclusive

# ─── Keybindings ──────────────────────────────────────────────────────
# Literal Esc+CR for shift+enter — distinguishes <CR> from <S-CR> in
# nvim/REPLs that listen for the bracketed sequence.
keybind = shift+enter=text:\x1b\r

# Free up Alt+arrows so terminal apps see Alt as Meta.
keybind = alt+left=unbind
keybind = alt+right=unbind

# Splits — vim mnemonics (v=vertical, d=down).
keybind = alt+v=new_split:right
keybind = alt+d=new_split:down

# Split navigation — hjkl.
keybind = alt+h=goto_split:left
keybind = alt+j=goto_split:down
keybind = alt+k=goto_split:up
keybind = alt+l=goto_split:right

# Split resize — same hjkl, ctrl+shift, 10-cell steps.
keybind = ctrl+shift+h=resize_split:left,10
keybind = ctrl+shift+j=resize_split:up,10
keybind = ctrl+shift+k=resize_split:down,10
keybind = ctrl+shift+l=resize_split:right,10

# Clear screen — mirrors Terminal.app muscle memory.
keybind = cmd+k=clear_screen

# Dump current screen to a file and paste its path. Workflow:
# type `nvim ` then hit alt+s to open the screen buffer in nvim.
keybind = alt+s=write_screen_file:paste
