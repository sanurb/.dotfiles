{
  "name": "pi-config",
  "private": true,
  "type": "module",
  "workspaces": [
    "agent/extensions/*"
  ],
  "scripts": {
    "check": "npm run typecheck && npm run test",
    "typecheck": "tsc --noEmit && npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present && node --import tsx --test agent/extensions/tests/*.test.ts"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^1.4.0",
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "@earendil-works/pi-tui": "^1.4.0",
    "typebox": "^1.1.38"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
