# Capture the absolute workspace path into a small file that flake.nix
# reads via the `devenv-root` flake input. devenv.lib.mkShell needs a
# known project root at eval time; pure-eval makes `./.` resolve to the
# nix store path (read-only), so we route through an external file
# that's overridden per-invocation. Empty file = no devenv shell (CI
# fallback). See flake.nix:inputs.devenv-root for the rationale.
echo "$PWD" > .devenv-root

use flake --impure --accept-flake-config \
  --override-input devenv-root "file+file://$PWD/.devenv-root"
