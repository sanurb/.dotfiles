# Load once, reload on demand. Without this, direnv re-evaluates the
# .envrc on every fish_prompt and every PWD change — and because the
# devenv dev shell's shellHook is the devenv task pipeline (treefmt:run
# over the whole repo + files:cleanup + enterShell→`proto use`), each
# re-eval costs seconds and silently reformats the tree on every `cd`.
# `nix_direnv_manual_reload` pins the cached profile: direnv emits the
# stored env diff per prompt (sub-millisecond) and only re-runs nix +
# the shellHook when you explicitly `direnv reload`. Run that after
# editing flake.nix / devenv.nix / .prototools. Must precede `use flake`
# so the flag is set before nix-direnv decides whether to reload.
nix_direnv_manual_reload

# Capture the absolute workspace path into a small file that flake.nix
# reads via the `devenv-root` flake input. devenv.lib.mkShell needs a
# known project root at eval time; pure-eval makes `./.` resolve to the
# nix store path (read-only), so we route through an external file
# that's overridden per-invocation. Empty file = no devenv shell (CI
# fallback). See flake.nix:inputs.devenv-root for the rationale.
#
# Write only when the content would change. An unconditional `echo >`
# bumps the mtime on every load, and .devenv-root is a watched flake
# input (--override-input below) — a bumped mtime marks the env stale
# and would defeat the manual-reload pin above by re-triggering the
# pipeline. Idempotent write keeps the cache warm across reloads.
[ "$(cat .devenv-root 2>/dev/null)" = "$PWD" ] || echo "$PWD" > .devenv-root

# `.` is the explicit flake-ref. Newer nix-direnv (>=3.x) refuses
# `use flake` without a positional argument with: "the first argument
# must be a flake expression". The flags following it are forwarded
# verbatim to `nix print-dev-env`.
use flake . --impure --accept-flake-config \
  --override-input devenv-root "file+file://$PWD/.devenv-root"
