.dots-state.toml

# devenv-root override sentinel — written by .envrc, holds $PWD so
# flake.nix can resolve the workspace at eval time. Per-machine.
.devenv-root

# Claude Code (per-session state, hooks, transcripts)
.claude/

# OS
.DS_Store

# Local bootstrap / install logs — per-machine, never committed
bootstrap.log
proto-*-install.log
