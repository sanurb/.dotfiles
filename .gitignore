# Nix / devenv
.devenv/
.devenv.flake.nix
.direnv/
.pre-commit-config.yaml
result
result-*
.result-home
.result-*

# Moon
.moon/cache/
.moon/docker/
# Generated git hooks (moon v2 writes them here and points core.hooksPath
# at this dir). `vcs.sync: true` regenerates them on any `moon run`, so
# they're derived artifacts — not source. See .moon/workspace.yml:hooks.
.moon/hooks/

# Proto
.proto/

# Go
apps/cli/bin/
apps/cli/coverage.out

# GoReleaser snapshot/release output
dist/

# Local identity (never committed — see modules/git.nix)
.local.identity.nix

# Persona state — written by `dots install`, host-specific. The committed
# .dots-state.toml.example documents the schema; the live file is local.
.dots-state.toml

# devenv-root override sentinel — written by .envrc, holds $PWD so
# flake.nix can resolve the workspace at eval time. Per-machine.
.devenv-root

# Claude Code (per-session state, hooks, transcripts)
.claude/

# Neovim machine-generated state — undo history and per-buffer context
# files written under %-escaped path names (e.g. CodeCompanion/AI plugins).
# Per-machine, may contain non-UTF-8 bytes; never committed or formatted.
config/nvim/.undodir/

# OS
.DS_Store

# Local bootstrap / install logs — per-machine, never committed
bootstrap.log
proto-*-install.log

# OrbStack-managed fish completions. OrbStack's installer writes these as
# symlinks into ~/.config/fish/completions/ pointing at the .app bundle;
# they land here because modules/home/shells/fish.nix mkOutOfStoreSymlinks
# the whole completions dir back into the repo. Same convention as
# config/fish/conf.d/orbstack.fish — the repo owns the hook, OrbStack
# owns the artifact.
config/fish/completions/docker.fish
config/fish/completions/kubectl.fish
config/fish/completions/orbctl.fish
